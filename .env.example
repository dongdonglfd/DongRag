MINIRAG_ADDR=:8080
DATABASE_URL=postgres://minirag:minirag@localhost:5432/minirag?sslmode=disable

# 阿里云百炼 OpenAI 兼容接口
BAILIAN_API_KEY=替换成你的百炼APIKey
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=glm-5.2

# 本地 Ollama Embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_CANDIDATE_K=50

# 本地 llama.cpp + BGE Cross-Encoder 重排序
RERANK_ENABLED=true
RERANK_URL=http://localhost:8081
RERANK_MAX_PER_DOC=2
RERANK_TIMEOUT_MS=30000
MAX_UPLOAD_MB=10

# Observability
METRICS_ENABLED=true
OTEL_SERVICE_NAME=minirag
# 留空则只保留本地 Trace API，不向外部 Collector 导出
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
